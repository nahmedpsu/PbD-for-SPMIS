{
  "$comment": "Conformance vectors for the PbD-SPMIS authorisation model. Both the embedded Python evaluator and the Rego policy must satisfy every vector: allow, release and reason_codes must match exactly; obligations_include must be a subset of the decision's obligations; obligations_exclude must be disjoint from it. Vectors are the executable form of the privacy tests in section 14.1 of the guide.",
  "vectors": [
    {
      "name": "appendix_a_case_worker_eligibility",
      "description": "The guide's Appendix A example: income becomes a threshold assertion, bank account is denied.",
      "guide_ref": "Appendix A; 14.1 Minimization",
      "input": {
        "actor": {"id": "cw-1", "role": "CASE_WORKER", "agency": "SOCIAL_PROTECTION_AGENCY", "programs": ["cash_assistance"], "amr": ["pwd"]},
        "subject": {"person_token": "P-8294AX", "program_relationship": ["cash_assistance"]},
        "program": "cash_assistance",
        "purpose": "eligibility_verification",
        "action": "read",
        "attributes": ["income", "household_size", "disability", "bank_account"],
        "context": {"device_trust": "managed"}
      },
      "expected": {
        "allow": true,
        "release": {"income": "assertion:below_threshold", "household_size": "exact", "disability": "deny", "bank_account": "deny"},
        "reason_codes": ["ALLOW"],
        "obligations_include": ["log", "no_export", "expire_response:24h"]
      }
    },
    {
      "name": "appendix_a_with_catalogue_attribute_names",
      "description": "Same request using the catalogue's attribute names: disability_status is asserted, address reduced to district.",
      "guide_ref": "Section 7 policy decision example",
      "input": {
        "actor": {"id": "cw-1", "role": "CASE_WORKER", "agency": "SOCIAL_PROTECTION_AGENCY", "programs": ["cash_assistance"], "amr": ["pwd"]},
        "subject": {"person_token": "P-8294AX", "program_relationship": ["cash_assistance"]},
        "program": "cash_assistance",
        "purpose": "eligibility_verification",
        "action": "read",
        "attributes": ["income", "disability_status", "bank_account", "address"],
        "context": {"device_trust": "managed"}
      },
      "expected": {
        "allow": true,
        "release": {"income": "assertion:below_threshold", "disability_status": "assertion:eligible", "bank_account": "deny", "address": "precision:district"},
        "reason_codes": ["ALLOW"],
        "obligations_include": ["log", "no_export", "expire_response:24h"]
      }
    },
    {
      "name": "purpose_enforcement_same_actor_disallowed_purpose",
